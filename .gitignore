# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.env/

# Logs (runtime generated)
logs/

# Data cache (downloaded at runtime)
data/oi_recordings/
strategies/PASHUPATASTRA_v1/results/shadow_trades.csv
data/historical/*.csv
data/historical/*.png

# Claude Code internal state
.claude/

# Node
node_modules/
frontend/brahmastra/node_modules/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets — never commit these
config/settings.local.yaml
config/.kite_token
scratchpad/

# Backtest data cache + net-run outputs (local)
data/intraday_cache/
reports/net_backtest_*.json

# Generated per-strategy backtest outputs (regenerated by every run — never track)
strategies/*/results/summary.json
strategies/*/results/equity_curve*.png
strategies/*/results/equity_curve*.csv
strategies/*/results/backtest*.csv
strategies/*/results/trades.csv
